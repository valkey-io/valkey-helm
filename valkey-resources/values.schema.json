{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["cluster"],
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "extraValues": {
      "type": "object",
      "additionalProperties": true,
      "description": "Free-form values referenced from templated strings in cluster.spec (and labels/annotations)."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "podMonitor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": ["string", "integer"] },
            "namespace": { "type": "string" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": true },
        "labels": { "type": "object", "additionalProperties": true },
        "automount": { "type": "boolean" }
      }
    },
    "cluster": {
      "type": "object",
      "required": ["spec"],
      "additionalProperties": true,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": true
        },
        "labels": {
          "type": "object",
          "additionalProperties": true
        },
        "spec": {
          "type": "object",
          "required": ["shards"],
          "additionalProperties": true,
          "description": "Drop-in for ValkeyCluster.spec; any CRD field is allowed.",
          "properties": {
            "shards": { "type": "integer", "minimum": 1 },
            "replicas": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "operator": { "type": "object", "additionalProperties": true },
        "allowExternal": { "type": "boolean" },
        "allowExternalEgress": { "type": "boolean" },
        "dnsNamespace": { "type": "string" },
        "extraIngress": { "type": "array" },
        "extraEgress": { "type": "array" },
        "labels": { "type": "object", "additionalProperties": true },
        "annotations": { "type": "object", "additionalProperties": true }
      }
    },
    "usersSecret": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "passwords": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "extraObjects": {
      "type": "object",
      "additionalProperties": { "type": ["object", "string", "null"] }
    }
  }
}
